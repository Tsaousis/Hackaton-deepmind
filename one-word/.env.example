# Local development only (read by Vite in `npm run dev`, never bundled).
VITE_GEMINI_API_KEY=
# Optional model override (default gemini-3.8-flash)
VITE_GEMINI_MODEL=

# Hosted build (set these in the Vercel project, not here):
#   GEMINI_API_KEY      key used by api/interpret.ts
#   GEMINI_MODEL        optional model override
#   RATE_PER_MINUTE     per-IP cap, default 20
#   RATE_PER_DAY        site-wide cap, default 3000
